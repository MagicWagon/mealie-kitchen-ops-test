# ==========================================
# GENERAL SETTINGS
# ==========================================
DRY_RUN=true
SCRIPT_TO_RUN=parser
LOG_LEVEL=INFO
# Maximum recipes per bulk tag/category request.
TAGGER_BULK_BATCH_SIZE=500
# Durable queue used by the parser's food/unit/alias review workflow.
PARSER_REVIEW_FILE=logs/parser_pending_catalog.json
# Durable completion history. Mount /app/state so this survives container replacement.
PARSER_HISTORY_FILE=/app/state/parse_history.json

# ==========================================
# MEALIE API (Used by: All Tools)
# ==========================================
MEALIE_URL=http://PLACEHOLDER_MEALIE_IP:9000
MEALIE_API_TOKEN=PLACEHOLDER_API_TOKEN

# ==========================================
# DATABASE SETTINGS (Accelerator Mode)
# ==========================================
# (Optional. Enables instant startup for Parser/Cleaner. Read-Only.)
# Options: sqlite, postgres
DB_TYPE=sqlite

# --- SQLite (path inside the container) ---
SQLITE_PATH=/app/data/mealie.db

# --- Postgres (uncomment and fill in if DB_TYPE=postgres) ---
# POSTGRES_HOST=PLACEHOLDER_POSTGRES_IP
# POSTGRES_PORT=5432
# POSTGRES_DB=mealie
# POSTGRES_USER=mealie
# POSTGRES_PASSWORD=PLACEHOLDER_DB_PASSWORD

# ==========================================
# PERFORMANCE TUNING
# ==========================================
# Number of concurrent threads for each script.
# Default of 2 is safe for most setups.
PARSER_WORKERS=2
CLEANER_WORKERS=2
